# Copy to .env and fill in. Never commit .env.

# LLM provider: groq (free tier, default) | ollama (free, local) | openai_compat | anthropic (paid)
LLM_PROVIDER=groq
# Groq key from console.groq.com (free). Not needed for ollama.
LLM_API_KEY=
# Optional overrides; empty = provider default (groq: openai/gpt-oss-120b, ollama: qwen2.5:7b)
LLM_BASE_URL=
LLM_MODEL=
# Extra free models, tried in order when the main one is rate limited (it then rests a while).
# "provider|model|api_key" separated by ";". provider = groq, gemini, openrouter, mistral,
# cerebras, or a full https:// OpenAI-compatible base URL. Groq limits are per model, so
# other Groq models with the same key are a free first step. Example:
# LLM_FALLBACKS=groq|llama-3.3-70b-versatile|GROQ_KEY;groq|qwen/qwen3-32b|GROQ_KEY;gemini|gemini-2.5-flash|GEMINI_KEY;gemini|gemini-2.5-flash-lite|GEMINI_KEY;mistral|mistral-small-latest|MISTRAL_KEY
LLM_FALLBACKS=
LLM_COOLDOWN_S=60
# Only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# With no usable provider the app runs on deterministic templates (evaluation condition 0).

# Optional Lichess personal token (raises rate limits, needed for masters explorer).
LICHESS_TOKEN=

# Contact address sent in the Chess.com User-Agent, as their API asks.
CHESSCOM_CONTACT_EMAIL=

# Path to the local Stockfish UCI binary.
STOCKFISH_PATH=engine/stockfish/stockfish-windows-x86-64-universal.exe
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128

# SQLAlchemy URL. SQLite by default.
# Leave empty to use repertoire.db in the repository root (absolute path, any working directory).
DATABASE_URL=

# OFFLINE=1 reads Lichess/Chess.com responses from backend/data/fixtures.
OFFLINE=0
# RECORD_FIXTURES=1 saves live API responses into backend/data/fixtures.
RECORD_FIXTURES=0

# Behaviour switches
RESPECT_GAMBITS=true

# Accounts. The admin is created/updated at startup when both values are set.
# Choose your own password; it is stored only as a salted hash in the database.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs login tokens. Empty = a random key saved in backend/data/cache (fine locally;
# set a long random value on the deployed site so logins survive restarts).
SECRET_KEY=

# Hugging Face write token for scripts/deploy_hf.py (optional if you used hf auth login)
HF_TOKEN=
